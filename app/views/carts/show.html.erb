<% content_for :body_class, 'bg-light' %>

<section class="section">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-10">
        <h1 class="title is-2 mb-5">Your Shopping Cart</h1>

        <% if @cart.line_items.empty? %>
          <div class="box has-text-centered py-6">
            <h3 class="title is-4">Your cart is empty</h3>
            <p class="subtitle is-6 mb-5">Find something awesome in our store!</p>
            <%= link_to "Keep Shopping", root_path, class: "button is-warning is-medium" %>
          </div>
        <% else %>
          <div class="box pa4">
            <table class="table is-fullwidth is-striped is-hoverable">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Quantity</th>
                  <th>Subtotal</th>
                  <th class="has-text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @cart.line_items.each do |item| %>
                  <tr>
                    <td>
                      <div class="is-flex is-align-items-center">
                        <% if item.product.image_url %>
                          <figure class="image is-48x48 mr-3">
                            <%= image_tag(item.product.image_url(:thumb)) %>
                          </figure>
                        <% end %>
                        <div>
                          <strong><%= link_to item.product.title, item.product %></strong>
                          <br>
                          <small class="has-text-grey">Sold by: <%= item.product.user.try(:name) || "Anonymous" %></small>
                        </div>
                      </div>
                    </td>
                    <td class="is-vcentered"><%= number_to_currency(item.product.price) %></td>
                    <td class="is-vcentered">
                      <div class="buttons has-addons">
                        <%= button_to "-", decrement_line_item_path(item), method: :put, class: "button is-small" %>
                        <span class="button is-small is-static"><%= item.quantity %></span>
                        <%= button_to "+", line_items_path(product_id: item.product.id), method: :post, class: "button is-small" %>
                      </div>
                    </td>
                    <td class="is-vcentered has-text-weight-semibold"><%= number_to_currency(item.total_price) %></td>
                    <td class="is-vcentered has-text-right">
                      <%= button_to "Remove", line_item_path(item), method: :delete, class: "button is-danger is-small is-outlined" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr>
                  <th colspan="3" class="has-text-right is-size-5">Total:</th>
                  <th colspan="2" class="is-size-4 has-text-danger-dark"><%= number_to_currency(@cart.total_price) %></th>
                </tr>
              </tfoot>
            </table>

            <div class="is-flex is-justify-content-space-between is-align-items-center mt-5">
              <%= link_to "Keep Shopping", root_path, class: "button is-light" %>

              <div class="buttons">
                <%= button_to "Empty cart", cart_path(@cart), method: :delete, data: { confirm: "Are you sure?" }, class: "button is-danger" %>
                <%= link_to "Proceed to Checkout", "#checkout-modal", class: "button is-success", onclick: "document.getElementById('checkout-modal').classList.add('is-active')" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Bonus Payment Modal -->
<div class="modal" id="checkout-modal">
  <div class="modal-background" onclick="document.getElementById('checkout-modal').classList.remove('is-active')"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">Checkout & Payment</p>
      <button class="delete" aria-label="close" onclick="document.getElementById('checkout-modal').classList.remove('is-active')"></button>
    </header>
    <section class="modal-card-body">
      <div class="notification is-info is-light mb-4">
        Order Total: <strong><%= number_to_currency(@cart.total_price) %></strong>
      </div>
      <form onsubmit="event.preventDefault(); alert('Payment successful! Thank you for your order.'); window.location.href = '<%= root_path %>';">
        <div class="field">
          <label class="label">Cardholder Name</label>
          <div class="control">
            <input class="input" type="text" placeholder="John Doe" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Card Number</label>
          <div class="control">
            <input class="input" type="text" placeholder="4532 •••• •••• 8890" required>
          </div>
        </div>
        <div class="columns">
          <div class="column is-6">
            <div class="field">
              <label class="label">Expiry Date</label>
              <div class="control">
                <input class="input" type="text" placeholder="MM/YY" required>
              </div>
            </div>
          </div>
          <div class="column is-6">
            <div class="field">
              <label class="label">CVC / CVV</label>
              <div class="control">
                <input class="input" type="password" placeholder="123" maxlength="4" required>
              </div>
            </div>
          </div>
        </div>
        <button type="submit" class="button is-success is-fullwidth is-medium mt-4">Pay <%= number_to_currency(@cart.total_price) %></button>
      </form>
    </section>
  </div>
</div>
